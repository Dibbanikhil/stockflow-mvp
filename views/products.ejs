<%- include('partials/header', { title }) %>
<section class="page-heading"><div><span class="eyebrow">CATALOG</span><h1>Products</h1><p class="muted">Manage your products, prices, and stock levels.</p></div><a class="button button-primary" href="/products/new">＋ Add product</a></section>
<section class="panel table-panel"><div class="section-heading"><div><h2>All products <span class="count-pill"><%= products.length %></span></h2><p class="muted">Search by product name or SKU.</p></div><div class="search-wrap"><span>⌕</span><input id="productSearch" type="search" placeholder="Search products..." value="<%= query %>" aria-label="Search products"></div></div>
<% if (products.length) { %><div class="table-wrap"><table id="productsTable"><thead><tr><th>Product</th><th>SKU</th><th>Quantity</th><th>Stock status</th><th>Selling price</th><th class="actions-head">Actions</th></tr></thead><tbody><% products.forEach(product => { const threshold = product.low_stock_threshold == null ? defaultThreshold : product.low_stock_threshold; const low = product.quantity <= threshold; %><tr data-search="<%= (product.name + ' ' + product.sku).toLowerCase() %>"><td><div class="product-cell"><span class="product-avatar"><%= product.name.charAt(0).toUpperCase() %></span><div><span class="product-name"><%= product.name %></span><% if (product.description) { %><small><%= product.description %></small><% } %></div></div></td><td><code class="sku"><%= product.sku %></code></td><td><strong class="<%= low ? 'quantity-low' : '' %>"><%= product.quantity %></strong></td><td><span class="status <%= low ? 'status-low' : 'status-ok' %>"><span></span><%= low ? 'Low stock' : 'In stock' %></span></td><td><%= formatMoney(product.selling_price) %></td><td><div class="row-actions"><a class="button button-secondary button-small" href="/products/<%= product.id %>/edit">Edit</a><form method="post" action="/products/<%= product.id %>/delete" onsubmit="return confirm('Delete this product? This cannot be undone.');"><button class="button button-danger button-small" type="submit">Delete</button></form></div></td></tr><% }) %></tbody></table><div class="no-results" id="noResults" hidden>No products match your search.</div></div><% } else { %><div class="empty-state"><span class="empty-icon">▦</span><h3>No products yet</h3><p>Add your first product to start tracking inventory.</p><a class="button button-primary" href="/products/new">Add your first product</a></div><% } %></section>
<script>const searchInput=document.getElementById('productSearch');if(searchInput){searchInput.addEventListener('input',()=>{const q=searchInput.value.toLowerCase().trim();let visible=0;document.querySelectorAll('#productsTable tbody tr').forEach(row=>{const show=row.dataset.search.includes(q);row.hidden=!show;if(show)visible++;});const empty=document.getElementById('noResults');if(empty)empty.hidden=visible!==0;});if(searchInput.value)searchInput.dispatchEvent(new Event('input'));}</script>
<%- include('partials/footer') %>
