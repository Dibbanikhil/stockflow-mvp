<%- include('partials/header', { title }) %>
<section class="page-heading"><div><span class="eyebrow">OVERVIEW</span><h1>Dashboard</h1><p class="muted">Here's what's happening with your inventory today.</p></div><a class="button button-primary" href="/products/new">＋ Add product</a></section>
<section class="stats-grid"><article class="stat-card"><div class="stat-label"><span class="stat-icon purple">▦</span>Total products</div><div class="stat-number"><%= totals.product_count %></div><div class="stat-foot">Unique products in your workspace</div></article><article class="stat-card"><div class="stat-label"><span class="stat-icon blue">▤</span>Units in stock</div><div class="stat-number"><%= Number(totals.unit_count).toLocaleString('en-IN') %></div><div class="stat-foot">Total quantity across all products</div></article><article class="stat-card"><div class="stat-label"><span class="stat-icon orange">!</span>Low-stock items</div><div class="stat-number"><%= lowStock.length %></div><div class="stat-foot">At or below their stock threshold</div></article></section>
<section class="panel table-panel"><div class="section-heading"><div><h2>Low-stock items</h2><p class="muted">Products that may need replenishment.</p></div><a class="text-link" href="/products">View all products →</a></div>
<% if (lowStock.length) { %><div class="table-wrap"><table><thead><tr><th>Product</th><th>SKU</th><th>Quantity</th><th>Threshold</th><th></th></tr></thead><tbody><% lowStock.forEach(product => { %><tr><td><span class="product-name"><%= product.name %></span></td><td><code class="sku"><%= product.sku %></code></td><td><strong class="quantity-low"><%= product.quantity %></strong></td><td><%= product.low_stock_threshold == null ? defaultThreshold : product.low_stock_threshold %> units</td><td><a class="text-link" href="/products/<%= product.id %>/edit">Update</a></td></tr><% }) %></tbody></table></div><% } else { %><div class="empty-state"><span class="empty-icon">✓</span><h3>You're in good shape</h3><p>No products are currently at or below their low-stock threshold.</p><a class="text-link" href="/products/new">Add a product →</a></div><% } %></section>
<div class="tip-banner"><span class="tip-icon">i</span><div><strong>Stock tip</strong><p>Set a default low-stock threshold of <%= defaultThreshold %> units in Settings. Products can also have their own threshold.</p></div><a href="/settings" class="text-link">Manage settings →</a></div>
<%- include('partials/footer') %>
