<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="StockFlow inventory management MVP">
  <title><%= title %> · StockFlow</title><link rel="stylesheet" href="/styles.css">
</head>
<body>
<header class="topbar">
  <a class="brand" href="<%= currentUser ? '/dashboard' : '/login' %>"><span class="brand-mark">S</span> StockFlow</a>
  <% if (currentUser) { %>
  <nav class="nav"><a href="/dashboard">Dashboard</a><a href="/products">Products</a><a href="/settings">Settings</a></nav>
  <div class="account"><span class="org-name"><%= currentUser.organizationName %></span><form action="/logout" method="post"><button class="button button-ghost button-small" type="submit">Log out</button></form></div>
  <% } else { %><nav class="nav"><a href="/login">Log in</a><a href="/signup">Create account</a></nav><% } %>
</header>
<main class="container">
  <% if (flash) { %><div class="alert alert-<%= flash.type %>" role="status"><%= flash.message %></div><% } %>
